{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "lib": [
      "es2022",
      "dom",
      "webworker"
    ],
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/tpms.js",
    "src/mesher.js",
    "src/metrics.js",
    "src/analysis.js",
    "src/fem.js",
    "src/bio.js",
    "src/lbm.js",
    "src/mechanics.js",
    "src/fabrication.js",
    "src/exporters.js",
    "src/project.js",
    "src/format.js",
    "src/stl.js",
    "src/charts.js",
    "src/flow.js",
    "src/geo.worker.js",
    "src/fem.worker.js",
    "src/bio.worker.js"
  ]
}